# The app runs ONLINE ONLY. Fill in ONE provider key below and save
# this file as `.env` in the project folder (next to app.py) - the app
# loads it automatically at startup. Alternatively export the
# variables in your shell before running `streamlit run app.py`.
# The provider is chosen by LLM_PROVIDER: gemini | openai | anthropic | groq
LLM_PROVIDER=groq
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Optional: override the default model for the chosen provider
# LLM_MODEL=
